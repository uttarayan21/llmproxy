# Environment Configuration

# Configuration file path (optional)
CONFIG_PATH=config.toml

# Server configuration
HOST=0.0.0.0
PORT=8080

# Database URL (SQLite by default)
DATABASE_URL=sqlite:llmproxy.db

# Authentication configuration (overrides config.toml if set)
# Enable session-based authentication (login/register)
AUTH_ENABLE_SESSION=true

# Enable reverse proxy header authentication
AUTH_ENABLE_HEADER=true
AUTH_HEADER_NAME=Remote-User

# Enable HTTP Basic Authentication
AUTH_ENABLE_BASIC=false

# Disable all authentication (USE WITH CAUTION!)
AUTH_DISABLE_ALL=false
