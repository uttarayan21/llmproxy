# Caddyfile for local LLMPROXY testing with authentication
# This configuration adds the Remote-User header and proxies all requests to the backend

# Main configuration
{
	# Disable automatic HTTPS for local testing
	auto_https off
	
	# Admin API endpoint (optional)
	admin localhost:2020
}

# Local testing server
:8081 {
	# Set Remote-User header for all requests
	# Change "dev-user" to your desired username
	
	# Proxy all requests to backend (which now serves the frontend too)
	reverse_proxy localhost:8080 {
		# Forward Remote-User header
		header_up Remote-User "dev-user"
		
		# Increase timeouts for LLM requests
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
	
	# Logging
	log {
		output file llmproxy.log
		format json
		level INFO
	}
}

